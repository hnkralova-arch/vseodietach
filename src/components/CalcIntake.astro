---
/**
 * Kalkulačka denního příjmu (Mifflin-St Jeor × aktivita).
 * Bezpečnost: deficit nejvýš 500 kcal nebo 20 %, nikdy pod spodní hranicí (výchozí 1 200 kcal), jen dospělí.
 * Vše běží v prohlížeči, nic se neodesílá ani neukládá.
 */
interface Props { floor?: number; helpHref?: string }
const { floor = 1200, helpHref = '/pomoc/' } = Astro.props;
---
<div class="calc" data-calc data-floor={floor}>
  <form class="calc-form" aria-label="Vaše údaje" novalidate>
    <fieldset class="field calc-sex">
      <legend class="lbl">Pohlaví</legend>
      <div class="seg">
        <label><input type="radio" name="sex" value="f" checked /><span>Žena</span></label>
        <label><input type="radio" name="sex" value="m" /><span>Muž</span></label>
      </div>
    </fieldset>
    <div class="field">
      <label for="calc-age">Věk</label>
      <div class="unit"><input id="calc-age" class="input" name="age" type="number" inputmode="numeric" min="18" max="100" value="35" /><span>let</span></div>
    </div>
    <div class="field">
      <label for="calc-height">Výška</label>
      <div class="unit"><input id="calc-height" class="input" name="height" type="number" inputmode="numeric" min="120" max="230" value="168" /><span>cm</span></div>
    </div>
    <div class="field">
      <label for="calc-weight">Hmotnost</label>
      <div class="unit"><input id="calc-weight" class="input" name="weight" type="number" inputmode="decimal" min="35" max="300" step="0.1" value="70" /><span>kg</span></div>
    </div>
    <div class="field calc-wide">
      <label for="calc-activity">Pohyb během týdne</label>
      <select id="calc-activity" class="input" name="activity">
        <option value="1.2">Skoro žádný, sedavá práce</option>
        <option value="1.375" selected>Lehký, 1–3× týdně</option>
        <option value="1.55">Střední, 3–5× týdně</option>
        <option value="1.725">Vysoký, 6–7× týdně</option>
        <option value="1.9">Velmi vysoký, fyzická práce a trénink</option>
      </select>
    </div>
  </form>

  <section class="vod-result" aria-label="Výsledek výpočtu" aria-live="polite" data-result>
    <div class="vod-result-grid">
      <div class="vod-result-item">
        <span class="vod-result-label">Na udržení váhy</span>
        <span class="vod-figure"><span data-keep>–</span><span class="vod-figure-unit">kcal denně</span></span>
        <p class="vod-result-explain">Odhad podle rovnice Mifflin-St Jeor a vaší aktivity.</p>
      </div>
      <div class="vod-result-item">
        <span class="vod-result-label">Na pozvolné hubnutí</span>
        <span class="vod-figure"><span data-lose>–</span><span class="vod-figure-unit">kcal denně</span></span>
        <p class="vod-result-explain" data-lose-text>Mírný deficit, se kterým se dá vydržet. Tempo kolem půl kilogramu týdně.</p>
      </div>
    </div>
    <aside class="vod-notice vod-notice-help" data-clamped hidden>
      <svg class="vod-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17s-6.5-3.8-6.5-8.3A3.5 3.5 0 0 1 10 6.6a3.5 3.5 0 0 1 6.5 2.1C16.5 13.2 10 17 10 17Z" /></svg>
      <div>
        <p class="vod-notice-title">Chcete jíst ještě méně?</p>
        <div class="vod-notice-body">Velmi nízký příjem tělo zatěžuje. Pokud vás jídlo nebo váha trápí, můžete si o tom promluvit s odborníkem.</div>
        <a class="vod-notice-action" href={helpHref}>Kde najít podporu</a>
      </div>
    </aside>
  </section>
  <p class="calc-error" role="alert" data-error hidden></p>
</div>

<style>
  .calc { display: grid; gap: var(--space-6); }
  .calc-form { background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--space-6); display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px var(--space-6); }
  .calc-wide { grid-column: 1 / -1; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { padding: 0; margin-bottom: var(--space-2); }
  .seg { display: flex; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); overflow: hidden; }
  .seg label { flex: 1; position: relative; }
  .seg input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seg span { display: grid; place-items: center; height: 46px; font-size: 17px; background: var(--paper); }
  .seg input:checked + span { background: var(--teal); color: var(--paper); font-weight: 700; }
  .seg input:focus-visible + span { box-shadow: inset 0 0 0 3px var(--berry); }
  .unit { position: relative; }
  .unit .input { padding-right: 52px; }
  .unit span { position: absolute; right: 14px; top: 12px; color: var(--ink-muted); font-size: 16px; pointer-events: none; }
  .calc-error { margin: 0; padding: var(--space-4) var(--space-6); background: var(--teal-wash); border-radius: var(--radius-lg); font-weight: 700; }
  .vod-result .vod-notice { margin-top: var(--space-6); }
</style>

<script>
  const nf = (v: number) => v.toLocaleString('cs-CZ', { maximumFractionDigits: 0 });
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const form = root.querySelector('form')!;
    const floor = Number(root.dataset.floor);
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const update = () => {
      const fd = new FormData(form);
      const age = Number(fd.get('age')), h = Number(fd.get('height')), w = Number(String(fd.get('weight')).replace(',', '.'));
      const act = Number(fd.get('activity')), male = fd.get('sex') === 'm';
      const problems: string[] = [];
      if (!(age >= 18 && age <= 100)) problems.push('Kalkulačka je pro dospělé od 18 let.');
      if (!(h >= 120 && h <= 230)) problems.push('Výšku zadejte v centimetrech, mezi 120 a 230.');
      if (!(w >= 35 && w <= 300)) problems.push('Hmotnost zadejte v kilogramech, mezi 35 a 300.');
      const err = $('[data-error]');
      if (problems.length) {
        err.textContent = problems.join(' ');
        err.hidden = false;
        $('[data-result]').hidden = true;
        return;
      }
      err.hidden = true;
      $('[data-result]').hidden = false;
      const bmr = 10 * w + 6.25 * h - 5 * age + (male ? 5 : -161);
      const keep = Math.round((bmr * act) / 10) * 10;
      const deficit = Math.min(500, Math.round((keep * 0.2) / 10) * 10);
      const raw = keep - deficit;
      // Pod hranicí zdravé hmotnosti (BMI 18,5) hubnutí nenabízíme vůbec.
      const underweight = w / Math.pow(h / 100, 2) < 18.5;
      const clamped = underweight || raw < floor;
      $('[data-keep]').textContent = nf(keep);
      $('[data-lose]').textContent = underweight ? '–' : nf(Math.max(raw, floor));
      $('[data-lose-text]').textContent = underweight
        ? 'Vaše hmotnost je pod zdravým rozmezím, hubnutí proto nepočítáme. Poraďte se s lékařem.'
        : clamped
          ? `Méně než ${nf(floor)} kcal denně neukazujeme. Tak nízký příjem patří pod dohled lékaře.`
          : 'Mírný deficit, se kterým se dá vydržet. Tempo kolem půl kilogramu týdně.';
      $('[data-clamped]').hidden = !clamped;
    };
    form.addEventListener('input', update);
    form.addEventListener('change', update);
    update();
  });
</script>
