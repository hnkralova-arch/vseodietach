---
import Base from '../layouts/Base.astro';
---
<Base title="Stránka nenalezena" description="Tahle stránka neexistuje." noindex>
  <div class="wrap" style="padding-top:64px">
    <h1 class="h1">Tahle stránka tu není</h1>
    <p class="lead">Možná se přesunula, nebo je v odkazu překlep. Zkuste začít jinde:</p>
    <p style="display:flex;flex-wrap:wrap;gap:12px">
      <a class="vod-btn vod-btn-primary" href="/">Na úvodní stránku</a>
      <a class="vod-btn vod-btn-secondary" href="/diety/">Diety A–Z</a>
    </p>
  </div>
</Base>
